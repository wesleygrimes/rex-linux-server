[Unit]
Description=Tuxosaurus, a Linux server for the Rex client
After=network.target

[Service]
ExecStart=%h/.local/bin/tuxosaurus --listen unix://%h/.local/state/tuxosaurus/server.sock --extra-listen http://127.0.0.1:51433 --state-dir %h/.local/state/tuxosaurus --shell /bin/bash
Restart=on-failure
RestartSec=3
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
